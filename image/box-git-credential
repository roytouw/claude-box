#!/bin/bash
# git credential helper: hands git the project's token for the host it talks to.
#   github.com            -> GH_TOKEN
#   $GITLAB_HOST / gitlab -> GITLAB_TOKEN
# Tokens come from the environment only (injected per project by claude-box), never from disk.
[[ "${1:-}" == "get" ]] || exit 0

host=""
while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  [[ "$key" == "host" ]] && host="$value"
done

gitlab_host="${GITLAB_HOST:-gitlab.com}"
gitlab_host="${gitlab_host#*://}"; gitlab_host="${gitlab_host%%/*}"

if [[ "$host" == "github.com" && -n "${GH_TOKEN:-}" ]]; then
  printf 'username=x-access-token\npassword=%s\n' "$GH_TOKEN"
elif [[ "$host" == "$gitlab_host" && -n "${GITLAB_TOKEN:-}" ]]; then
  printf 'username=oauth2\npassword=%s\n' "$GITLAB_TOKEN"
fi
