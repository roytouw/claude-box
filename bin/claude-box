#!/bin/bash
# claude-box: run Claude Code in a Docker container, separated from the host setup.
#
#   claude-box [options] [workspace] [-- <claude args>]
#   claude-box doctor [workspace]            check your setup (changes nothing)
#   claude-box init [--own-profile] [workspace] <repo-url>..  create a workspace (several repos = one)
#   claude-box secret <workspace> <VAR>      store the clipboard in the Keychain, check it, clear it
#   claude-box set <workspace> <key> <value> profile (name or "own") | connectors | docker | gcloud | color | env
#                                            | git-name | git-email | signing (on: makes an SSH signing key)
#   claude-box list                          your workspaces
#   claude-box profiles                      profiles (Claude homes) and which account is logged in
#   claude-box trust <workspace>             trust the workspace and its repo folders in its profile
#   claude-box gcloud-login <workspace>      log gcloud in for this workspace only (needs gcloud on)
#
# Starts `claude agents` (agent view: your sessions, start or resume background agents).
#
# [workspace] is a folder name under $CLAUDE_BOX_WORKSPACES (default ~/claude-box/workspaces,
# default name "scratch"), created if missing. If it contains .claude-box/, that configures it:
#   .claude-box/Dockerfile   project image, FROM ghcr.io/roytouw/claude-box:base
#   .claude-box/secrets.txt  env var names, read from Keychain items "claude-box/<workspace>/<VAR>"
#   .claude-box/mcp.json     MCP servers for claude (use ${VAR} for secrets)
#   .claude-box/env          non-secret env vars, KEY=value per line (e.g. GITLAB_HOST)
#   .claude-box/color        terminal background while the box runs, e.g. #4A2208
#   .claude-box/profile      profile to use for this workspace, e.g. work (default: private)
#   .claude-box/connectors   "on" enables the Claude account's claude.ai connectors (default: off)
#   .claude-box/docker       "on" gives the box its own private Docker daemon (default: off)
#   .claude-box/gcloud       "on" adds the Google Cloud CLI, logged in per workspace (default: off)
#   .claude-box/git-name     git user.name in the box, e.g. Jane Doe
#   .claude-box/git-email    git user.email; must be a verified email on your GitHub/GitLab account
#   .claude-box/signing      "on" signs commits and tags with the workspace's SSH key (default: off)
#
# Options:
#   --chat         start a plain new `claude` chat instead of agent view
#   --shell        open bash in the box instead of claude
#   --profile P    home volume to use (Claude login, plugins, memory); overrides .claude-box/profile
#   --pull         pull the latest base image first
#   --build-base   build the base image locally from this repo, then exit
#   -h, --help
set -euo pipefail

BOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BASE_IMAGE="ghcr.io/roytouw/claude-box:base"
WS_ROOT="${CLAUDE_BOX_WORKSPACES:-$HOME/claude-box/workspaces}"

profile=""; shell=0; chat=0; pull=0; ws=""; gcloud_login=0
claude_args=()

case "${1:-}" in
  doctor|init|set|secret|list|profiles|trust)
    # shellcheck source=../lib/commands.sh
    source "$BOX_DIR/lib/commands.sh"; sub="$1"; shift; "cmd_$sub" "$@"; exit $? ;;
  gcloud-login)   # a normal start of the workspace's box, running only the gcloud login
    gcloud_login=1; shift
    [[ $# -eq 1 && "$1" != -* ]] || { echo "usage: claude-box gcloud-login <workspace>" >&2; exit 2; } ;;
esac

usage() { sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chat) chat=1 ;;
    --shell) shell=1 ;;
    --profile) profile="$2"; shift ;;
    --pull) pull=1 ;;
    --build-base) docker build --pull -t "$BASE_IMAGE" "$BOX_DIR/image"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; claude_args=("$@"); break ;;
    -*) echo "unknown option: $1" >&2; usage; exit 2 ;;
    *) [[ -n "$ws" ]] && { echo "only one workspace allowed" >&2; exit 2; }; ws="$1" ;;
  esac
  shift
done

ws="${ws:-scratch}"
[[ "$ws" =~ ^[A-Za-z0-9._-]+$ && "$ws" != "." && "$ws" != ".." ]] \
  || { echo "workspace must be a plain name, got: $ws" >&2; exit 2; }

ws_path="$WS_ROOT/$ws"
cfg="$ws_path/.claude-box"

# Project settings: one value per file, so they are trivial to read and diff.
setting() { [[ -f "$cfg/$1" ]] && head -1 "$cfg/$1" | tr -d "[:space:]" || true; }
line_setting() { [[ -f "$cfg/$1" ]] && sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$cfg/$1" || true; }   # keeps inner spaces
gcloud="$(setting gcloud)"; [[ "$gcloud" == "on" ]] || gcloud="off"
if [[ $gcloud_login -eq 1 && "$gcloud" != "on" ]]; then
  echo "gcloud is off for $ws; turn it on first: claude-box set $ws gcloud on" >&2; exit 2
fi
mkdir -p "$ws_path"
[[ -z "$profile" ]] && profile="$(setting profile)"
profile="${profile:-private}"
[[ "$profile" =~ ^[A-Za-z0-9_-]+$ ]] \
  || { echo "profile must be a plain name, got: $profile" >&2; exit 2; }
connectors="$(setting connectors)"; [[ "$connectors" == "on" ]] || connectors="off"
echo "[claude-box] workspace $ws · profile $profile · connectors $connectors · gcloud $gcloud" >&2

# --- image -----------------------------------------------------------------------------------
if [[ $pull -eq 1 ]] || ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
  docker pull "$BASE_IMAGE"
fi
image="$BASE_IMAGE"
if [[ -f "$cfg/Dockerfile" ]]; then
  image="claude-box-project-$(echo "$ws" | tr '[:upper:]' '[:lower:]')"
  echo "[claude-box] building project image $image" >&2
  docker build -q -t "$image" "$cfg" >/dev/null
fi
# Google Cloud CLI: a layer on top of the workspace's image (cached after the first build).
gcloud_args=()
if [[ "$gcloud" == "on" ]]; then
  gcloud_image="claude-box-gcloud-$(echo "$ws" | tr '[:upper:]' '[:lower:]')"
  docker image inspect "$gcloud_image" >/dev/null 2>&1 \
    || echo "[claude-box] adding the Google Cloud CLI to the image (a few minutes, once)" >&2
  docker build -q --build-arg "BASE=$image" -t "$gcloud_image" "$BOX_DIR/image/gcloud" >/dev/null
  image="$gcloud_image"
  # Its login, ADC and kubeconfig live in a volume of this workspace, not in the profile's home.
  gcloud_args=(-v "claude-box-gcloud-${ws}:/gcloud")
fi

# --- secrets: Keychain item "claude-box/<workspace>/<VAR>" -> env VAR -------------------------
# Scoped to this workspace's namespace, so a project can never ask for other Keychain items.
env_args=()
if [[ -f "$cfg/secrets.txt" ]]; then
  while read -r var; do
    var="${var%%#*}"; var="$(echo "$var" | xargs)"
    [[ -z "$var" ]] && continue
    [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "[claude-box] skipping invalid name: $var" >&2; continue; }
    if val="$(security find-generic-password -s "claude-box/$ws/$var" -w 2>/dev/null)" && [[ -n "$val" ]]; then
      export "$var=$val"
      env_args+=(-e "$var")
    else
      echo "[claude-box] missing secret $var; copy it, then run: claude-box secret $ws $var" >&2
    fi
  done < "$cfg/secrets.txt"
  unset val
fi

# Non-secret settings: .claude-box/env with KEY=value lines (e.g. GITLAB_HOST=gitlab.example.com).
if [[ -f "$cfg/env" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[A-Z_][A-Z0-9_]*=.*$ ]]; then env_args+=(-e "$line")
    else echo "[claude-box] skipping invalid env line: $line" >&2; fi
  done < "$cfg/env"
fi

[[ "$connectors" == "on" ]] && env_args+=(-e ENABLE_CLAUDEAI_MCP_SERVERS=true)

# --- git identity and commit signing (per workspace) ---------------------------------------------
# Passed as GIT_CONFIG_* env vars: they act like config for every git command in the box and
# override anything in the profile's ~/.gitconfig. The signing key is a dedicated SSH key of this
# workspace (made by `claude-box set <ws> signing on`), kept in the Keychain and written to the
# container's own /tmp at start, never to the profile's home volume.
SIGNING_KEY=/tmp/claude-box-signing-key
git_cfg=(); signing=off
git_name="$(line_setting git-name)"; git_email="$(line_setting git-email)"
[[ -n "$git_name" ]] && git_cfg+=(user.name "$git_name")
[[ -n "$git_email" ]] && git_cfg+=(user.email "$git_email")
if [[ "$(setting signing)" == "on" ]]; then
  if key="$(security find-generic-password -s "claude-box/$ws/GIT_SIGNING_KEY" -w 2>/dev/null)" && [[ -n "$key" ]]; then
    export CLAUDE_BOX_SIGNING_KEY="$key"; env_args+=(-e CLAUDE_BOX_SIGNING_KEY); signing=on
    git_cfg+=(gpg.format ssh user.signingkey "$SIGNING_KEY" gpg.ssh.allowedSignersFile "$SIGNING_KEY.allowed"
              commit.gpgsign true tag.gpgsign true)
  else
    echo "[claude-box] signing is on but the signing key is missing; run: claude-box set $ws signing on" >&2
  fi
  unset key
fi
[[ -z "$git_email" ]] && echo "[claude-box] no git identity; set one: claude-box set $ws git-email you@example.com" >&2
if [[ ${#git_cfg[@]} -gt 0 ]]; then
  env_args+=(-e "GIT_CONFIG_COUNT=$(( ${#git_cfg[@]} / 2 ))")
  for ((i = 0; i < ${#git_cfg[@]}; i += 2)); do
    env_args+=(-e "GIT_CONFIG_KEY_$((i / 2))=${git_cfg[i]}" -e "GIT_CONFIG_VALUE_$((i / 2))=${git_cfg[i + 1]}")
  done
fi

if [[ $gcloud_login -eq 1 ]]; then
  # No browser redirect to localhost in a container: gcloud prints a URL, you paste back the code.
  cmd=(gcloud auth login --update-adc --no-launch-browser)
elif [[ $shell -eq 1 ]]; then
  cmd=(bash)
else
  # Agent view lists every background session in the profile; show only this workspace's.
  if [[ $chat -eq 1 ]]; then cmd=(claude); else cmd=(claude agents --cwd "/workspace/$ws"); fi
  [[ -f "$cfg/mcp.json" ]] && cmd+=(--mcp-config "/workspace/$ws/.claude-box/mcp.json")
  cmd+=("${claude_args[@]+"${claude_args[@]}"}")
fi
if [[ "$signing" == "on" ]]; then
  # Write the key (only readable by the agent user) and the allowed-signers file for verifying
  # locally, drop the key from the environment, then run the real command.
  cmd=(bash -c 'umask 077
    printf "%s" "$CLAUDE_BOX_SIGNING_KEY" | base64 -d > "$0"
    printf "%s namespaces=\"git\" %s\n" "$(git config user.email)" "$(ssh-keygen -y -f "$0")" > "$0.allowed"
    unset CLAUDE_BOX_SIGNING_KEY
    exec "$@"' "$SIGNING_KEY" "${cmd[@]}")
fi

# --- host bridge: container xdg-open/$BROWSER -> `open` on the Mac, and clipboard images --------
# One request per connection: a token line, then a request line. A URL is opened in the Mac's
# browser. clip-has-image / clip-image let xclip in the box (box-clip) paste an image from the Mac
# clipboard, so Ctrl+V in Claude Code works. Only images are served, never clipboard text: secrets
# pass through the Mac clipboard (claude-box secret).
# code:<path> comes from `code <path>` in the box (box-code): the path is mapped to the workspace
# folder on the Mac and opened in $CLAUDE_BOX_EDITOR (default: VS Code's `code`, e.g. `cursor` or
# `zed`). Only paths that resolve (symlinks followed, on the Mac) to inside the workspace are opened.
ws_real="$(cd "$ws_path" && pwd -P)"
open_in_editor() {
  local p="$1" target real editor
  [[ "$p" == "/workspace/$ws" || "$p" == "/workspace/$ws/"* ]] || return 0
  target="$ws_path${p#"/workspace/$ws"}"
  if [[ -d "$target" ]]; then
    real="$(cd "$target" 2>/dev/null && pwd -P)" || return 0
  elif [[ -f "$target" && ! -L "$target" ]]; then
    real="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)/$(basename "$target")" || return 0
  else
    return 0
  fi
  [[ "$real" == "$ws_real" || "$real" == "$ws_real/"* ]] || return 0
  read -ra editor <<< "${CLAUDE_BOX_EDITOR:-code}"
  if command -v "${editor[0]}" >/dev/null 2>&1; then
    "${editor[@]}" "$real" >/dev/null 2>&1 &
  elif [[ "${editor[0]}" == "code" ]]; then
    open -a "Visual Studio Code" "$real" >/dev/null 2>&1 &
  fi
}
open_port=""
for p in $(jot -r 30 20000 60000); do
  nc -z 127.0.0.1 "$p" 2>/dev/null || { open_port="$p"; break; }
done
open_token="$(openssl rand -hex 16)"
bridge_pid=""
bridge_dir=""
serve_bridge_request() {
  local t="" req="" png="$bridge_dir/clip.png"
  { read -r t && read -r req; } || return 0
  if [[ "$t" != "$open_token" ]]; then sleep 0.2; return 0; fi
  case "$req" in
    clip-has-image)
      if osascript -e 'the clipboard as «class PNGf»' >/dev/null 2>&1; then echo yes; else echo no; fi ;;
    clip-image)
      rm -f "$png"
      if osascript -e 'set png_data to (the clipboard as «class PNGf»)' \
           -e "set fp to open for access POSIX file \"$png\" with write permission" \
           -e 'write png_data to fp' -e 'close access fp' >/dev/null 2>&1 && [[ -s "$png" ]]; then
        echo "png $(wc -c < "$png" | tr -d ' ')"
        cat "$png"
      else
        echo none
      fi
      rm -f "$png" ;;
    code:/workspace/*)
      open_in_editor "${req#code:}" ;;
    *)
      if [[ "$req" =~ ^https?://[^[:space:]]+$ ]]; then open "$req"; fi ;;
  esac
  return 0
}
if [[ -n "$open_port" ]] && bridge_dir="$(mktemp -d)" && mkfifo "$bridge_dir/reply"; then
  (
    # nc reads the reply from a fifo the handler writes to (macOS bash 3.2 has no coproc).
    while true; do
      nc -l 127.0.0.1 "$open_port" < "$bridge_dir/reply" | serve_bridge_request > "$bridge_dir/reply"
    done
  ) 2>/dev/null &
  bridge_pid=$!
  disown "$bridge_pid"
fi
# --- terminal: project background color + title, restored on exit ------------------------------
# Standard escape codes (OSC 11 / OSC 2), ignored by terminals that don't support them.
# Kitty/xterm: push/pop the color and title stacks, so the exact previous state comes back.
tty_out=""; color_set=0
{ : > /dev/tty; } 2>/dev/null && tty_out=/dev/tty
if [[ -n "$tty_out" ]]; then
  printf '\033[22;0t' > "$tty_out"                                   # push title
  printf '\033]2;claude-box: %s\033\\' "$ws" > "$tty_out"
  if [[ -f "$cfg/color" ]]; then
    color="$(head -1 "$cfg/color" | tr -d '[:space:]')"
    if [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
      [[ -n "${KITTY_WINDOW_ID:-}" ]] && printf '\033[#P' > "$tty_out"   # push colors
      printf '\033]11;%s\033\\' "$color" > "$tty_out"
      color_set=1
    else
      echo "[claude-box] ignoring .claude-box/color: expected #RRGGBB, got: $color" >&2
    fi
  fi
fi

# The workspace's own config is read-only inside the box (and its Docker daemon): an agent must not
# be able to turn on docker/connectors, add secrets or change the image for the next start.
# Changes come from the host (claude-box set/secret/init or the MCP server).
cfg_ro=()
[[ -d "$cfg" ]] && cfg_ro=(-v "$cfg:/workspace/$ws/.claude-box:ro")

# --- optional Docker: a private daemon per workspace (.claude-box/docker = on) -------------------
# Never the host's Docker Desktop socket: that would let the box mount your whole home folder.
# The daemon runs privileged in its own container, sees only the workspace (at the same path, so
# bind mounts and compose files work), and the box shares its network so published ports are on
# localhost. Images are cached per workspace. It stops when the last box using it exits.
DIND_IMAGE="docker:29.9.2-dind"
dind_name="claude-box-dind-${ws}"
net_args=(--hostname "claude-box-${ws}")
dind_args=()
if [[ "$(setting docker)" == "on" ]]; then
  if [[ "$(docker inspect -f '{{.State.Running}}' "$dind_name" 2>/dev/null)" != "true" ]]; then
    docker rm -f "$dind_name" >/dev/null 2>&1 || true
    echo "[claude-box] starting private Docker daemon for $ws" >&2
    docker image inspect "$DIND_IMAGE" >/dev/null 2>&1 || docker pull -q "$DIND_IMAGE" >/dev/null
    docker run -d --privileged --name "$dind_name" \
      -v "claude-box-dind-${ws}:/var/lib/docker" \
      -v "claude-box-dind-run-${ws}:/run/dind" \
      -v "$ws_path:/workspace/$ws" "${cfg_ro[@]+"${cfg_ro[@]}"}" \
      "$DIND_IMAGE" dockerd --host=unix:///run/dind/docker.sock --group=1000 >/dev/null
  fi
  for _ in $(seq 1 60); do
    docker exec "$dind_name" docker -H unix:///run/dind/docker.sock info >/dev/null 2>&1 && break
    sleep 0.5
  done
  net_args=(--network "container:$dind_name")
  dind_args=(-v "claude-box-dind-run-${ws}:/run/dind" -e DOCKER_HOST=unix:///run/dind/docker.sock
             --label "claude-box.uses-dind=$dind_name")
fi

cleanup() {
  if [[ ${#dind_args[@]} -gt 0 && -z "$(docker ps -q --filter "label=claude-box.uses-dind=$dind_name")" ]]; then
    docker rm -f "$dind_name" >/dev/null 2>&1
  fi
  [[ -n "$bridge_pid" ]] && kill "$bridge_pid" 2>/dev/null
  [[ -n "$open_port" ]] && pkill -f "nc -l 127.0.0.1 $open_port" 2>/dev/null
  [[ -n "$bridge_dir" ]] && rm -rf "$bridge_dir"
  if [[ -n "$tty_out" ]]; then
    if [[ $color_set -eq 1 ]]; then
      if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then printf '\033[#Q' > "$tty_out"   # pop colors
      else printf '\033]111\033\\' > "$tty_out"; fi                             # reset background
    fi
    printf '\033[23;0t' > "$tty_out"                                 # pop title
  fi
  return 0
}
trap cleanup EXIT

# Only the workspace and the profile's home volume are mounted. Nothing from the host home
# (~/.claude, ~/.ssh, ~/.gitconfig, gh/glab/gcloud config) and no env passthrough beyond the above.
# Each project gets its own path (/workspace/<name>), so Claude keeps separate history per project.
docker run --rm -it --init \
  --name "claude-box-${profile}-${ws}-$$" \
  "${net_args[@]}" \
  -e CLAUDE_BOX_OPEN_PORT="$open_port" -e CLAUDE_BOX_OPEN_TOKEN="$open_token" \
  -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
  "${env_args[@]+"${env_args[@]}"}" \
  "${dind_args[@]+"${dind_args[@]}"}" \
  "${gcloud_args[@]+"${gcloud_args[@]}"}" \
  -v "claude-box-home-${profile}:/home/agent" \
  -v "$ws_path:/workspace/$ws" "${cfg_ro[@]+"${cfg_ro[@]}"}" -w "/workspace/$ws" \
  "$image" "${cmd[@]}"
