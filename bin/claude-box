#!/bin/bash
# claude-box: run Claude Code in a Docker container, separated from the host setup.
#
#   claude-box [workspace] [options] [-- <claude args>]   start the box (options in any order)
#
#   Set up
#   claude-box init [--own-profile] [workspace] <repo-url>...  create a workspace (several repos = one)
#   claude-box set <workspace> <key> <value>    profile | connectors | docker | gcloud | sync | color | env
#                                               | git-name | git-email | signing | skills
#   claude-box secret <workspace> <VAR>         store the clipboard in the Keychain, check it, clear it
#   claude-box trust <workspace>                trust the workspace and its repo folders in its profile
#   claude-box gcloud-login <workspace>         log gcloud in for this workspace only (needs gcloud on)
#
#   Check
#   claude-box doctor [workspace]               check your setup and fix hints (changes nothing)
#   claude-box list                             your workspaces, their settings and detached boxes
#   claude-box profiles                         profiles (Claude homes) and which account is logged in
#   claude-box clean [workspace] [--go]         free disk space: workspace Docker daemons, old images,
#                                               | build cache; --go also Go's caches in profile homes
#
#   Detached boxes (started with --detached)
#   claude-box status <workspace>               running or not, restarts, last log lines
#   claude-box logs <workspace>                 follow its output (Ctrl+C stops following, not the box)
#   claude-box stop <workspace>                 run its --exit script, then stop and remove it
#
#   claude-box update                           install the newest release
#   claude-box <command> -h                     help for one command
#
# Without --chat, --shell or --detached it starts `claude agents` (agent view: your sessions,
# start or resume background agents).
#
# [workspace] is a folder name under $CLAUDE_BOX_WORKSPACES (default ~/claude-box/workspaces). It
# must exist (create it with init), except the default "scratch". Its .claude-box/ configures it:
#   .claude-box/Dockerfile   project image, FROM ghcr.io/roytouw/claude-box:base
#   .claude-box/secrets.txt  env var names, read from Keychain items "claude-box/<workspace>/<VAR>"
#   .claude-box/mcp.json     MCP servers for claude (use ${VAR} for secrets)
#   .claude-box/env          non-secret env vars, KEY=value per line (e.g. GITLAB_HOST)
#   .claude-box/color        terminal background while the box runs, e.g. #4A2208
#   .claude-box/profile      profile to use for this workspace, e.g. work (default: private)
#   .claude-box/connectors   "on" enables the Claude account's claude.ai connectors (default: off)
#   .claude-box/docker       "on" gives the box its own private Docker daemon (default: off)
#   .claude-box/gcloud       "on" adds the Google Cloud CLI, logged in per workspace (default: off)
#   .claude-box/sync         "off" stops updating the repos on start (default: on, see --no-sync)
#   .claude-box/git-name     git user.name in the box, e.g. Jane Doe
#   .claude-box/git-email    git user.email; must be a verified email on your GitHub/GitLab account
#   .claude-box/signing      "on" signs commits and tags with the workspace's SSH key (default: off)
#   .claude-box/skills       "off" stops mounting your skills from the Mac's ~/.claude/skills
#                            (default: on, read-only)
#
# Options:
#   --chat                  a plain new `claude` chat instead of agent view
#   --shell                 bash instead of claude
#   --detached '<script> [args]'
#                           run a script from the workspace in the background instead of claude.
#                           One quoted string: path relative to the workspace, then its args.
#                           The script must stay in the foreground: when it exits, the box restarts
#                           it. It keeps running after the terminal closes and comes back with Docker.
#   --exit '<script> [args]'
#                           with --detached: what `claude-box stop` runs in the box first
#   --logs                  with --detached: follow its output once it started, like
#                           `claude-box logs` (Ctrl+C stops following, not the box)
#   --port <mac>[:<box>]    open localhost:<mac> on the Mac to port <box> (default: the same) on
#                           localhost in the box, e.g. a dev server for your browser. Repeat it or
#                           give a comma list (--port 3000,8080:80). Works with --detached too
#   --profile <name>        Claude home to use; overrides .claude-box/profile
#   --no-sync               don't fetch the repos this time. By default every start fetches origin and
#                           fast-forwards a repo that is on its default branch with no local changes;
#                           others are left alone and reported
#   --pull                  pull the latest base image first
#   --build-base            build the base image locally from this repo, then exit
#   -h, --help              this help
#
# Example:
#   claude-box hue --detached 'jira-agent/agent.sh run' --exit 'jira-agent/agent.sh stop' --logs
set -euo pipefail

BOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BASE_IMAGE="ghcr.io/roytouw/claude-box:base"
DIND_IMAGE="docker:29.9.2-dind"   # a workspace's private Docker daemon (docker on)
WS_ROOT="${CLAUDE_BOX_WORKSPACES:-$HOME/claude-box/workspaces}"

profile=""; shell=0; chat=0; pull=0; sync=1; ws=""; gcloud_login=0; detached=""; exit_cmd=""; follow_logs=0
claude_args=(); port_specs=()

usage() { sed -n '2,/^[^#]/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }   # the header comment above
# The usage line(s) of one command, from the header: the single place commands are documented.
cmd_usage() {   # its line plus continuation lines (indented further, starting with |)
  usage | awk -v c="  claude-box $1" '
    index($0, c " ") == 1 || $0 == c { print "usage: " substr($0, 3); on = 1; next }
    on && /^ +\| / { print "       " substr($0, 3); next }
    { on = 0 }'
}
COMMANDS="init set secret trust gcloud-login doctor list profiles clean status logs stop update"

case "${1:-}" in
  doctor|init|set|secret|list|profiles|clean|trust|update|status|logs|stop)
    sub="$1"; shift
    for a in "$@"; do [[ "$a" == -h || "$a" == --help ]] && { cmd_usage "$sub"; exit 0; }; done
    # shellcheck source=../lib/commands.sh
    source "$BOX_DIR/lib/commands.sh"; "cmd_$sub" "$@"; exit $? ;;
  gcloud-login)   # a normal start of the workspace's box, running only the gcloud login
    gcloud_login=1; shift
    [[ $# -eq 1 && "$1" != -* ]] || { cmd_usage gcloud-login >&2; exit 2; } ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chat) chat=1 ;;
    --shell) shell=1 ;;
    --profile) profile="$2"; shift ;;
    --port)
      [[ $# -ge 2 && -n "$2" ]] || { echo "--port needs <mac>[:<box>], e.g. --port 3000 or --port 8080:3000" >&2; exit 2; }
      IFS=, read -ra _specs <<< "$2"; port_specs+=("${_specs[@]}")
      shift ;;
    --detached|--exit)
      [[ $# -ge 2 && -n "$2" ]] || { echo "$1 needs a script path" >&2; exit 2; }
      if [[ "$1" == --detached ]]; then detached="$2"; else exit_cmd="$2"; fi
      shift ;;
    --logs) follow_logs=1 ;;
    --pull) pull=1 ;;
    --no-sync) sync=0 ;;
    --build-base) docker build --pull -t "$BASE_IMAGE" "$BOX_DIR/image"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; claude_args=("$@"); break ;;
    -*) echo "unknown option: $1" >&2; usage; exit 2 ;;
    *) if [[ -n "$ws" ]]; then   # e.g. a mistyped command: `claude-box stpo hue`
         echo "only one workspace allowed, got: $ws and $1" >&2
         echo "commands: $COMMANDS (claude-box -h for all)" >&2; exit 2
       fi
       ws="$1" ;;
  esac
  shift
done

ws="${ws:-scratch}"
[[ "$ws" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "workspace must be a plain name, got: $ws" >&2; exit 2; }

ws_path="$WS_ROOT/$ws"
cfg="$ws_path/.claude-box"
if [[ ! -d "$ws_path" && "$ws" != scratch ]]; then
  echo "no workspace $ws in $WS_ROOT" >&2
  echo "create it with: claude-box init [$ws] <repo-url>   (or mkdir it for an empty one; claude-box list shows yours)" >&2
  exit 2
fi

# --- detached: a script from the workspace, running in the background --------------------------
# --detached and --exit each take one string: a script path and its arguments, split on spaces
# (so arguments can't contain spaces). The script is a regular file inside the workspace folder
# (given relative to it, or as /workspace/<ws>/...), so only what is in the workspace can run.
workspace_script() {   # "<path> [args]" -> script_cmd=(/workspace/<ws>/<path> args...), or exits
  local words rel script real
  read -ra words <<< "$1"
  [[ ${#words[@]} -gt 0 ]] || { echo "empty script command" >&2; exit 2; }
  rel="${words[0]#"/workspace/$ws/"}"; rel="${rel#./}"
  [[ "$rel" != /* ]] || { echo "script must be a path inside the workspace, got: ${words[0]}" >&2; exit 2; }
  script="$ws_path/$rel"
  [[ -f "$script" && ! -L "$script" ]] || { echo "no such script in $ws (or it is a symlink): $rel" >&2; exit 2; }
  real="$(cd "$(dirname "$script")" && pwd -P)/$(basename "$script")"
  [[ "$real" == "$(cd "$ws_path" && pwd -P)/"* ]] || { echo "script must be inside the workspace: $rel" >&2; exit 2; }
  [[ -x "$script" ]] || { echo "script is not executable; run: chmod +x $script" >&2; exit 2; }
  script_cmd=("/workspace/$ws/$rel" "${words[@]:1}")
}
detached_container="claude-box-detached-${ws}"
if [[ -n "$exit_cmd" && -z "$detached" ]]; then
  echo "--exit only works together with --detached" >&2; exit 2
fi
if [[ "$follow_logs" == 1 && -z "$detached" ]]; then
  echo "--logs only works together with --detached (for a box that already runs: claude-box logs $ws)" >&2; exit 2
fi
if [[ -n "$detached" ]]; then
  [[ $shell -eq 0 && $chat -eq 0 && $gcloud_login -eq 0 ]] \
    || { echo "--detached can't be combined with --shell or --chat" >&2; exit 2; }
  workspace_script "$detached"
  detached_cmd=("${script_cmd[@]}" "${claude_args[@]+"${claude_args[@]}"}")
  exit_label=()
  if [[ -n "$exit_cmd" ]]; then
    workspace_script "$exit_cmd"
    exit_label=(--label "claude-box.exit=${script_cmd[*]}")
  fi
  if [[ -n "$(docker ps -q --filter "name=^/${detached_container}\$")" ]]; then
    echo "$ws already runs detached; stop it first: claude-box stop $ws" >&2; exit 1
  fi
fi

# --- ports: --port <mac>[:<box>] -> 127.0.0.1:<mac> on the Mac, <box> on localhost in the box ----
# Docker publishes each one (on the Mac's 127.0.0.1 only) to a relay port in the box, and a small
# relay in the box passes connections on to localhost:<box>. So a dev server that only listens on
# localhost works too, and the forward is part of the container: it keeps working for a detached
# box after Docker restarts. Relay ports are RELAY_BASE + n; nothing else should listen there.
RELAY_BASE=29000
port_pub=(); port_dind=(); relay_spec=""; port_label=""; mac_ports=()
for spec in "${port_specs[@]+"${port_specs[@]}"}"; do
  spec="${spec//[[:space:]]/}"; [[ -n "$spec" ]] || continue
  [[ "$spec" =~ ^([0-9]{1,5})(:([0-9]{1,5}))?$ ]] \
    || { echo "--port expects <mac>[:<box>] (e.g. 3000 or 8080:3000), got: $spec" >&2; exit 2; }
  mac=$((10#${BASH_REMATCH[1]})); box=$((10#${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}))
  for p in "$mac" "$box"; do
    [[ $p -ge 1 && $p -le 65535 ]] || { echo "port out of range: $p" >&2; exit 2; }
  done
  [[ " ${mac_ports[*]-} " != *" $mac "* ]] || { echo "--port $mac given twice" >&2; exit 2; }
  relay=$((RELAY_BASE + ${#mac_ports[@]}))
  mac_ports+=("$mac")
  port_pub+=(-p "127.0.0.1:$mac:$relay")
  port_dind+=("$relay/tcp=$mac")
  relay_spec+="${relay_spec:+,}$relay:$box"
  port_label+="${port_label:+,}$mac:$box"
done
# Docker would fail on a Mac port that is already taken; say which one and why instead.
check_mac_ports() {
  local p
  for p in "${mac_ports[@]+"${mac_ports[@]}"}"; do
    if nc -z 127.0.0.1 "$p" 2>/dev/null; then
      echo "port $p is already in use on the Mac (another box, or an app there); pick another: --port <mac>:<box>" >&2
      exit 1
    fi
  done
}

# Project settings: one value per file, so they are trivial to read and diff.
setting() { [[ -f "$cfg/$1" ]] && head -1 "$cfg/$1" | tr -d "[:space:]" || true; }
line_setting() { [[ -f "$cfg/$1" ]] && sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$cfg/$1" || true; }   # keeps inner spaces
gcloud="$(setting gcloud)"; [[ "$gcloud" == "on" ]] || gcloud="off"
if [[ $gcloud_login -eq 1 && "$gcloud" != "on" ]]; then
  echo "gcloud is off for $ws; turn it on first: claude-box set $ws gcloud on" >&2; exit 2
fi
mkdir -p "$ws_path"
[[ -z "$profile" ]] && profile="$(setting profile)"
profile="${profile:-private}"
[[ "$profile" =~ ^[A-Za-z0-9_-]+$ ]] \
  || { echo "profile must be a plain name, got: $profile" >&2; exit 2; }
connectors="$(setting connectors)"; [[ "$connectors" == "on" ]] || connectors="off"
echo "[claude-box] workspace $ws · profile $profile · connectors $connectors · gcloud $gcloud" >&2

# --- skills: your skills from the Mac's ~/.claude/skills, mounted read-only (on by default) -------
# Each skill folder goes in on its own at the same place in the profile's home, so edits on the Mac
# show up in the box right away, the box can't change them, and it can still add skills of its own
# next to them. Nothing else from ~/.claude goes in. A skill added on the Mac needs a new start.
HOST_SKILLS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
skill_args=(); skill_names=()
if [[ "$(setting skills)" != off && -d "$HOST_SKILLS" ]]; then
  for dir in "$HOST_SKILLS"/*/; do
    name="$(basename "$dir")"
    [[ -f "$dir/SKILL.md" && "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
    skill_args+=(-v "$(cd -P "$dir" && pwd):/home/agent/.claude/skills/$name:ro")
    skill_names+=("$name")
  done
  [[ ${#skill_names[@]} -gt 0 ]] && echo "[claude-box] your skills, read-only: ${skill_names[*]} (opt out: claude-box set $ws skills off)" >&2
fi

# --- repos: fetch origin, fast-forward where nothing can be lost (sync_repos in lib/commands.sh) ---
# shellcheck source=../lib/commands.sh
source "$BOX_DIR/lib/commands.sh"
if [[ $sync -eq 1 && $gcloud_login -eq 0 && "$(setting sync)" != off ]]; then
  sync_repos "$ws" || true
fi

# --- image -----------------------------------------------------------------------------------
# A pull or rebuild that moves a tag leaves the old image behind untagged (GBs each). Remember
# "<tag> <old id>" pairs, newest first, and remove the old ones once everything is built.
replaced=()
if [[ $pull -eq 1 ]] || ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
  old="$(image_id "$BASE_IMAGE")"
  docker pull "$BASE_IMAGE"
  replaced=("$BASE_IMAGE" "$old")
fi
image="$BASE_IMAGE"
if [[ -f "$cfg/Dockerfile" ]]; then
  image="claude-box-project-$(echo "$ws" | tr '[:upper:]' '[:lower:]')"
  echo "[claude-box] building project image $image" >&2
  old="$(image_id "$image")"
  docker build -q -t "$image" "$cfg" >/dev/null
  replaced=("$image" "$old" "${replaced[@]+"${replaced[@]}"}")
fi
# Google Cloud CLI: a layer on top of the workspace's image (cached after the first build).
gcloud_args=()
if [[ "$gcloud" == "on" ]]; then
  gcloud_image="claude-box-gcloud-$(echo "$ws" | tr '[:upper:]' '[:lower:]')"
  docker image inspect "$gcloud_image" >/dev/null 2>&1 \
    || echo "[claude-box] adding the Google Cloud CLI to the image (a few minutes, once)" >&2
  old="$(image_id "$gcloud_image")"
  docker build -q --build-arg "BASE=$image" -t "$gcloud_image" "$BOX_DIR/image/gcloud" >/dev/null
  replaced=("$gcloud_image" "$old" "${replaced[@]+"${replaced[@]}"}")
  image="$gcloud_image"
  # Its login, ADC and kubeconfig live in a volume of this workspace, not in the profile's home.
  gcloud_args=(-v "claude-box-gcloud-${ws}:/gcloud")
fi
# Newest first: an old gcloud image builds on the old project image, which builds on the old base.
for ((i = 0; i < ${#replaced[@]}; i += 2)); do drop_replaced "${replaced[i]}" "${replaced[i + 1]}"; done

# --- secrets: Keychain item "claude-box/<workspace>/<VAR>" -> env VAR -------------------------
# Scoped to this workspace's namespace, so a project can never ask for other Keychain items.
env_args=()
if [[ -f "$cfg/secrets.txt" ]]; then
  while read -r var; do
    var="${var%%#*}"; var="$(echo "$var" | xargs)"
    [[ -z "$var" ]] && continue
    [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "[claude-box] skipping invalid name: $var" >&2; continue; }
    if val="$(security find-generic-password -s "claude-box/$ws/$var" -w 2>/dev/null)" && [[ -n "$val" ]]; then
      export "$var=$val"
      env_args+=(-e "$var")
    else
      echo "[claude-box] missing secret $var; copy it, then run: claude-box secret $ws $var" >&2
    fi
  done < "$cfg/secrets.txt"
  unset val
fi

# Non-secret settings: .claude-box/env with KEY=value lines (e.g. GITLAB_HOST=gitlab.example.com).
if [[ -f "$cfg/env" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ ^[A-Z_][A-Z0-9_]*=.*$ ]]; then env_args+=(-e "$line")
    else echo "[claude-box] skipping invalid env line: $line" >&2; fi
  done < "$cfg/env"
fi

[[ "$connectors" == "on" ]] && env_args+=(-e ENABLE_CLAUDEAI_MCP_SERVERS=true)

# --- git identity and commit signing (per workspace) ---------------------------------------------
# Passed as GIT_CONFIG_* env vars: they act like config for every git command in the box and
# override anything in the profile's ~/.gitconfig. The signing key is a dedicated SSH key of this
# workspace (made by `claude-box set <ws> signing on`), kept in the Keychain and written to the
# container's own /tmp at start, never to the profile's home volume.
SIGNING_KEY=/tmp/claude-box-signing-key
git_cfg=(); signing=off
git_name="$(line_setting git-name)"; git_email="$(line_setting git-email)"
[[ -n "$git_name" ]] && git_cfg+=(user.name "$git_name")
[[ -n "$git_email" ]] && git_cfg+=(user.email "$git_email")
if [[ "$(setting signing)" == "on" ]]; then
  if key="$(security find-generic-password -s "claude-box/$ws/GIT_SIGNING_KEY" -w 2>/dev/null)" && [[ -n "$key" ]]; then
    export CLAUDE_BOX_SIGNING_KEY="$key"; env_args+=(-e CLAUDE_BOX_SIGNING_KEY); signing=on
    git_cfg+=(gpg.format ssh user.signingkey "$SIGNING_KEY" gpg.ssh.allowedSignersFile "$SIGNING_KEY.allowed"
              commit.gpgsign true tag.gpgsign true)
  else
    echo "[claude-box] signing is on but the signing key is missing; run: claude-box set $ws signing on" >&2
  fi
  unset key
fi
[[ -z "$git_email" ]] && echo "[claude-box] no git identity; set one: claude-box set $ws git-email you@example.com" >&2
if [[ ${#git_cfg[@]} -gt 0 ]]; then
  env_args+=(-e "GIT_CONFIG_COUNT=$(( ${#git_cfg[@]} / 2 ))")
  for ((i = 0; i < ${#git_cfg[@]}; i += 2)); do
    env_args+=(-e "GIT_CONFIG_KEY_$((i / 2))=${git_cfg[i]}" -e "GIT_CONFIG_VALUE_$((i / 2))=${git_cfg[i + 1]}")
  done
fi

if [[ -n "$detached" ]]; then
  cmd=("${detached_cmd[@]}")
elif [[ $gcloud_login -eq 1 ]]; then
  # Opens the sign-in in the Mac's browser; the bridge relays its localhost redirect into the box.
  cmd=(gcloud auth login --update-adc)
elif [[ $shell -eq 1 ]]; then
  cmd=(bash)
else
  # Agent view lists every background session in the profile; show only this workspace's.
  if [[ $chat -eq 1 ]]; then cmd=(claude); else cmd=(claude agents --cwd "/workspace/$ws"); fi
  [[ -f "$cfg/mcp.json" ]] && cmd+=(--mcp-config "/workspace/$ws/.claude-box/mcp.json")
  cmd+=("${claude_args[@]+"${claude_args[@]}"}")
fi
if [[ "$signing" == "on" ]]; then
  # Write the key (only readable by the agent user) and the allowed-signers file for verifying
  # locally, drop the key from the environment, then run the real command.
  cmd=(bash -c 'umask 077
    printf "%s" "$CLAUDE_BOX_SIGNING_KEY" | base64 -d > "$0"
    printf "%s namespaces=\"git\" %s\n" "$(git config user.email)" "$(ssh-keygen -y -f "$0")" > "$0.allowed"
    unset CLAUDE_BOX_SIGNING_KEY
    exec "$@"' "$SIGNING_KEY" "${cmd[@]}")
fi

if [[ -n "$relay_spec" ]]; then
  # The relay for --port: listens on the relay ports, dials localhost:<box> (IPv4, then IPv6) per
  # connection. Runs next to the command; the box (and so the relay) lives as long as it does.
  cmd=(bash -c 'node -e "$1" "$2" & shift 2; exec "$@"' _ "$(cat <<'JS'
process.on('uncaughtException', () => {});
const net = require('net');
for (const pair of process.argv[1].split(',')) {
  const [listen, port] = pair.split(':').map(Number);
  const server = net.createServer(c => {
    c.on('error', () => {});
    c.pause();
    const dial = hosts => {
      if (!hosts.length) return c.destroy();
      const s = net.connect(port, hosts[0]);
      s.once('error', () => dial(hosts.slice(1)));
      s.once('connect', () => {
        s.removeAllListeners('error');
        s.on('error', () => c.destroy());
        c.on('error', () => s.destroy());
        c.pipe(s); s.pipe(c); c.resume();
      });
    };
    dial(['127.0.0.1', '::1']);
  });
  // In use: another box sharing this network (same Docker daemon) relays it already; take over
  // once that one exits.
  server.on('error', () => setTimeout(() => server.listen(listen), 2000)).listen(listen);
}
JS
)" "$relay_spec" "${cmd[@]}")
fi

# --- host bridge: container xdg-open/$BROWSER -> `open` on the Mac, and clipboard images --------
# One request per connection: a token line, then a request line. A URL is opened in the Mac's
# browser. clip-has-image / clip-image let xclip in the box (box-clip) paste an image from the Mac
# clipboard, so Ctrl+V in Claude Code works. Only images are served, never clipboard text: secrets
# pass through the Mac clipboard (claude-box secret).
# code:<path> comes from `code <path>` in the box (box-code): the path is mapped to the workspace
# folder on the Mac and opened in $CLAUDE_BOX_EDITOR (default: VS Code's `code`, e.g. `cursor` or
# `zed`). Only paths that resolve (symlinks followed, on the Mac) to inside the workspace are opened.
ws_real="$(cd "$ws_path" && pwd -P)"
open_in_editor() {
  local p="$1" target real editor
  [[ "$p" == "/workspace/$ws" || "$p" == "/workspace/$ws/"* ]] || return 0
  target="$ws_path${p#"/workspace/$ws"}"
  if [[ -d "$target" ]]; then
    real="$(cd "$target" 2>/dev/null && pwd -P)" || return 0
  elif [[ -f "$target" && ! -L "$target" ]]; then
    real="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)/$(basename "$target")" || return 0
  else
    return 0
  fi
  [[ "$real" == "$ws_real" || "$real" == "$ws_real/"* ]] || return 0
  read -ra editor <<< "${CLAUDE_BOX_EDITOR:-code}"
  if command -v "${editor[0]}" >/dev/null 2>&1; then
    "${editor[@]}" "$real" >/dev/null 2>&1 &
  elif [[ "${editor[0]}" == "code" ]]; then
    open -a "Visual Studio Code" "$real" >/dev/null 2>&1 &
  fi
}
container="claude-box-${profile}-${ws}-$$"
open_port=""
# A detached box outlives this script, and the bridge with it, so it gets none.
[[ -z "$detached" ]] && for p in $(jot -r 30 20000 60000); do
  nc -z 127.0.0.1 "$p" 2>/dev/null || { open_port="$p"; break; }
done
open_token="$(openssl rand -hex 16)"
bridge_pid=""
bridge_dir=""
serve_bridge_request() {
  local t="" req="" png="$bridge_dir/clip.png"
  { read -r t && read -r req; } || return 0
  if [[ "$t" != "$open_token" ]]; then sleep 0.2; return 0; fi
  case "$req" in
    clip-has-image)
      if osascript -e 'the clipboard as «class PNGf»' >/dev/null 2>&1; then echo yes; else echo no; fi ;;
    clip-image)
      rm -f "$png"
      if osascript -e 'set png_data to (the clipboard as «class PNGf»)' \
           -e "set fp to open for access POSIX file \"$png\" with write permission" \
           -e 'write png_data to fp' -e 'close access fp' >/dev/null 2>&1 && [[ -s "$png" ]]; then
        echo "png $(wc -c < "$png" | tr -d ' ')"
        cat "$png"
      else
        echo none
      fi
      rm -f "$png" ;;
    code:/workspace/*)
      open_in_editor "${req#code:}" ;;
    *)
      if [[ "$req" =~ ^https?://[^[:space:]]+$ ]]; then relay_sign_in_redirect "$req"; open "$req"; fi ;;
  esac
  return 0
}
# A sign-in started in the box (gcloud auth login and other OAuth logins) sends the browser back
# to http://localhost:<port> on the Mac, while the tool listens on localhost in the box. Relay that
# port into the box, one connection at a time, until the tool stops listening (or 5 minutes pass).
# Nothing is published, so boxes don't fight over ports; a port already taken on the Mac is skipped.
relay_sign_in_redirect() {
  local re='redirect_uri=http(%3[Aa]|:)(%2[Ff]|/)(%2[Ff]|/)(localhost|127\.0\.0\.1)(%3[Aa]|:)([0-9]+)'
  [[ "$1" =~ $re ]] || return 0
  local port="${BASH_REMATCH[6]}"
  [[ $port -ge 1024 && $port -le 65535 ]] || return 0
  nc -z 127.0.0.1 "$port" 2>/dev/null && return 0
  (
    to_box="$bridge_dir/relay-$port-in"; from_box="$bridge_dir/relay-$port-out"
    mkfifo "$to_box" "$from_box" || exit 0
    trap 'pkill -f "nc -l 127.0.0.1 $port\$"; rm -f "$to_box" "$from_box"' EXIT
    end=$((SECONDS + 300))
    while [[ $SECONDS -lt $end ]]; do
      nc -l 127.0.0.1 "$port" < "$from_box" > "$to_box" &
      # In the box: connect to the tool (fails once it stops listening), pipe the browser's request in and
      # its response out. Redirects in this order, or the two fifo opens wait on each other.
      docker exec -i "$container" bash -c '
        exec 3<>"/dev/tcp/127.0.0.1/$1" 2>/dev/null || exit 7
        exec 4<&0; cat <&4 >&3 & exec timeout 300 cat <&3' _ "$port" > "$from_box" < "$to_box"
      status=$?
      # macOS nc keeps the browser's connection open after the response; closing it ends the page.
      pkill -f "nc -l 127.0.0.1 $port\$"
      [[ $status -eq 0 ]] || break   # tool gone, login abandoned (timeout) or docker failed
    done
  ) </dev/null >/dev/null 2>&1 &
}
if [[ -n "$open_port" ]] && bridge_dir="$(mktemp -d)" && mkfifo "$bridge_dir/reply"; then
  (
    # nc reads the reply from a fifo the handler writes to (macOS bash 3.2 has no coproc).
    while true; do
      nc -l 127.0.0.1 "$open_port" < "$bridge_dir/reply" | serve_bridge_request > "$bridge_dir/reply"
    done
  ) 2>/dev/null &
  bridge_pid=$!
  disown "$bridge_pid"
fi
# --- terminal: project background color + title, restored on exit ------------------------------
# Standard escape codes (OSC 11 / OSC 2), ignored by terminals that don't support them.
# Kitty/xterm: push/pop the color and title stacks, so the exact previous state comes back.
tty_out=""; color_set=0
[[ -z "$detached" ]] && { : > /dev/tty; } 2>/dev/null && tty_out=/dev/tty
if [[ -n "$tty_out" ]]; then
  printf '\033[22;0t' > "$tty_out"                                   # push title
  printf '\033]2;claude-box: %s\033\\' "$ws" > "$tty_out"
  if [[ -f "$cfg/color" ]]; then
    color="$(head -1 "$cfg/color" | tr -d '[:space:]')"
    if [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
      [[ -n "${KITTY_WINDOW_ID:-}" ]] && printf '\033[#P' > "$tty_out"   # push colors
      printf '\033]11;%s\033\\' "$color" > "$tty_out"
      color_set=1
    else
      echo "[claude-box] ignoring .claude-box/color: expected #RRGGBB, got: $color" >&2
    fi
  fi
fi

# The workspace's own config is read-only inside the box (and its Docker daemon): an agent must not
# be able to turn on docker/connectors, add secrets or change the image for the next start.
# Changes come from the host (claude-box set/secret/init or the MCP server).
cfg_ro=()
[[ -d "$cfg" ]] && cfg_ro=(-v "$cfg:/workspace/$ws/.claude-box:ro")

# --- optional Docker: a private daemon per workspace (.claude-box/docker = on) -------------------
# Never the host's Docker Desktop socket: that would let the box mount your whole home folder.
# The daemon runs privileged in its own container, sees only the workspace (at the same path, so
# bind mounts and compose files work), and the box shares its network so published ports are on
# localhost. Images are cached per workspace. It stops when the last box using it exits.
dind_name="claude-box-dind-${ws}"
net_args=(--hostname "claude-box-${ws}")
dind_args=()
# A detached box shares the daemon's network, so the daemon must come back with it after a restart.
dind_restart=(); [[ -n "$detached" ]] && dind_restart=(--restart unless-stopped)
# The box shares the daemon's network, so --port is published on the daemon's container. Ports are
# fixed when it starts: a running one with other ports is restarted when no box uses it any more.
dind_ports() {   # its published ports, one "<relay>/tcp=<mac>" per line, sorted
  docker inspect -f '{{range $p, $b := .HostConfig.PortBindings}}{{$p}}={{(index $b 0).HostPort}}{{"\n"}}{{end}}' \
    "$dind_name" 2>/dev/null | sed '/^$/d' | sort
}
if [[ "$(setting docker)" == "on" ]]; then
  if [[ ${#port_dind[@]} -gt 0 && "$(docker inspect -f '{{.State.Running}}' "$dind_name" 2>/dev/null)" == "true" \
        && "$(dind_ports)" != "$(printf '%s\n' "${port_dind[@]}" | sort)" ]]; then
    if [[ -n "$(docker ps -q --filter "label=claude-box.uses-dind=$dind_name")" ]]; then
      echo "another box of $ws runs and shares its Docker daemon, which was started with other ports." >&2
      echo "Start this one with the same --port as that box, or stop that box first." >&2
      exit 1
    fi
    docker rm -f "$dind_name" >/dev/null 2>&1 || true
  fi
  if [[ "$(docker inspect -f '{{.State.Running}}' "$dind_name" 2>/dev/null)" != "true" ]]; then
    docker rm -f "$dind_name" >/dev/null 2>&1 || true
    check_mac_ports
    echo "[claude-box] starting private Docker daemon for $ws" >&2
    docker image inspect "$DIND_IMAGE" >/dev/null 2>&1 || docker pull -q "$DIND_IMAGE" >/dev/null
    docker run -d --privileged --name "$dind_name" "${dind_restart[@]+"${dind_restart[@]}"}" \
      "${port_pub[@]+"${port_pub[@]}"}" \
      -v "claude-box-dind-${ws}:/var/lib/docker" \
      -v "claude-box-dind-run-${ws}:/run/dind" \
      -v "$ws_path:/workspace/$ws" "${cfg_ro[@]+"${cfg_ro[@]}"}" \
      "$DIND_IMAGE" dockerd --host=unix:///run/dind/docker.sock --group=1000 >/dev/null
  fi
  for _ in $(seq 1 60); do
    docker exec "$dind_name" docker -H unix:///run/dind/docker.sock info >/dev/null 2>&1 && break
    sleep 0.5
  done
  [[ -n "$detached" ]] && docker update --restart unless-stopped "$dind_name" >/dev/null
  net_args=(--network "container:$dind_name")
  port_pub=()   # published on the daemon above
  dind_args=(-v "claude-box-dind-run-${ws}:/run/dind" -e DOCKER_HOST=unix:///run/dind/docker.sock
             --label "claude-box.uses-dind=$dind_name")
fi

# --- port-forwards: kubectl/k9s port-forwards in the box -> localhost on the Mac ------------------
# The box publishes no ports; a helper on the Mac mirrors the ports kubectl/k9s listen on inside
# it (on 127.0.0.1 only) and relays each connection with `docker exec`. See lib/port-forward.py.
# A detached box outlives this script, so it gets none (like the bridge).
fwd_pid=""
fwd_py=()
if [[ -n "${CLAUDE_BOX_PYTHON:-}" ]]; then fwd_py=("$CLAUDE_BOX_PYTHON")   # the uv-installed command
elif command -v uv >/dev/null 2>&1; then fwd_py=(uv run -q --no-project python)
fi
if [[ -z "$detached" && ${#fwd_py[@]} -gt 0 ]]; then
  "${fwd_py[@]}" "$BOX_DIR/lib/port-forward.py" "$container" </dev/null >/dev/null 2>&1 &
  fwd_pid=$!
  disown "$fwd_pid"
fi

cleanup() {
  [[ -n "$fwd_pid" ]] && kill "$fwd_pid" 2>/dev/null
  if [[ ${#dind_args[@]} -gt 0 && -z "$(docker ps -q --filter "label=claude-box.uses-dind=$dind_name")" ]]; then
    docker rm -f "$dind_name" >/dev/null 2>&1
  fi
  [[ -n "$bridge_pid" ]] && kill "$bridge_pid" 2>/dev/null
  [[ -n "$open_port" ]] && pkill -f "nc -l 127.0.0.1 $open_port" 2>/dev/null
  [[ -n "$bridge_dir" ]] && rm -rf "$bridge_dir"
  if [[ -n "$tty_out" ]]; then
    if [[ $color_set -eq 1 ]]; then
      if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then printf '\033[#Q' > "$tty_out"   # pop colors
      else printf '\033]111\033\\' > "$tty_out"; fi                             # reset background
    fi
    printf '\033[23;0t' > "$tty_out"                                 # pop title
  fi
  return 0
}
trap cleanup EXIT

# Only the workspace and the profile's home volume are mounted. Nothing from the host home
# (~/.claude, ~/.ssh, ~/.gitconfig, gh/glab/gcloud config) and no env passthrough beyond the above,
# except your skills from ~/.claude/skills (read-only, unless .claude-box/skills is off).
# Each project gets its own path (/workspace/<name>), so Claude keeps separate history per project.
run_mode=(--rm -it --name "$container")
[[ ${#dind_args[@]} -eq 0 ]] && check_mac_ports
port_args=()
[[ -n "$port_label" ]] && port_args=(--label "claude-box.ports=$port_label" "${port_pub[@]+"${port_pub[@]}"}")
if [[ -n "$detached" ]]; then
  # No --rm: Docker keeps it and starts it again when Docker Desktop (or the Mac) restarts.
  docker rm -f "$detached_container" >/dev/null 2>&1 || true   # a stopped one from before
  run_mode=(-d --restart unless-stopped --name "$detached_container" "${exit_label[@]+"${exit_label[@]}"}")
  echo "[claude-box] running ${detached_cmd[*]#"/workspace/$ws/"} detached in $ws" >&2
  [[ ${#exit_label[@]} -gt 0 ]] && echo "[claude-box]   on stop: ${exit_label[1]#"claude-box.exit=/workspace/$ws/"}" >&2
  for p in ${port_label//,/ }; do echo "[claude-box]   http://localhost:${p%%:*} -> port ${p#*:} in the box" >&2; done
  echo "[claude-box]   logs: claude-box logs $ws · stop: claude-box stop $ws" >&2
  exec 3>&1 >/dev/null   # docker run -d prints the container id; messages go to stderr (3: for --logs)
  # Claude Code keeps its background-session daemon's lock in ~/.claude, which every box of the
  # profile shares, but the daemon's pid and control socket only exist inside one container. A
  # daemon started here would hold that lock where no other box can reach it, and their
  # `claude agents` would hang. Nobody looks at agent view in a detached box: turn it off (it also
  # turns off --bg and the on-demand daemon). Last, so a workspace env setting can't undo it.
  env_args+=(-e CLAUDE_CODE_DISABLE_AGENT_VIEW=1)
fi
# Docker would create the skills' parent folder in the home volume as root, and the box couldn't
# add skills of its own there; make it as the box's user first.
if [[ ${#skill_args[@]} -gt 0 ]]; then
  docker run --rm --entrypoint mkdir -v "claude-box-home-${profile}:/home/agent" "$image" -p /home/agent/.claude/skills \
    || echo "[claude-box] couldn't create ~/.claude/skills in profile $profile" >&2
fi
docker run "${run_mode[@]}" --init \
  "${net_args[@]}" "${port_args[@]+"${port_args[@]}"}" \
  -e CLAUDE_BOX_OPEN_PORT="$open_port" -e CLAUDE_BOX_OPEN_TOKEN="$open_token" \
  -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
  "${env_args[@]+"${env_args[@]}"}" \
  "${dind_args[@]+"${dind_args[@]}"}" \
  "${gcloud_args[@]+"${gcloud_args[@]}"}" \
  -v "claude-box-home-${profile}:/home/agent" "${skill_args[@]+"${skill_args[@]}"}" \
  -v "$ws_path:/workspace/$ws" "${cfg_ro[@]+"${cfg_ro[@]}"}" -w "/workspace/$ws" \
  "$image" "${cmd[@]}"

# A detached script must keep running; one that returns (e.g. it backgrounds its work and exits)
# makes Docker restart it over and over. Watch the first seconds and explain that instead.
if [[ -n "$detached" ]]; then
  for _ in $(seq 1 8); do
    sleep 1
    state="$(docker inspect -f '{{.State.Status}} {{.RestartCount}} {{.State.ExitCode}}' "$detached_container" 2>/dev/null || echo "gone 0 ?")"
    read -r status restarts code _ <<< "$state"
    [[ "$status" == running && "$restarts" == 0 ]] && continue
    echo "[claude-box] the script exited (status $code) instead of staying in the foreground; last output:" >&2
    docker logs --tail 20 "$detached_container" 2>&1 | sed 's/^/    /' >&2
    docker rm -f "$detached_container" >/dev/null 2>&1 || true
    echo "[claude-box] removed it again. --detached needs a script that keeps running: use its" >&2
    echo "[claude-box] foreground mode, or end it with \`exec <long-running command>\` or \`wait\`." >&2
    exit 1
  done
  echo "[claude-box] $ws is running detached; check it with: claude-box status $ws" >&2
  if [[ "$follow_logs" == 1 ]]; then
    echo "[claude-box] following its output (Ctrl+C stops following, not the box)" >&2
    exec docker logs -f --tail 100 "$detached_container" >&3 3>&-
  fi
fi
